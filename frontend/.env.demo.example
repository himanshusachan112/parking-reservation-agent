# ─────────────────────────────────────────────
# PUBLIC DEMO TEMPLATE — frontend/.env.demo.example
# Copy to frontend/.env.local and fill in your ngrok URL.
# This file IS committed to git (no secrets here).
# ─────────────────────────────────────────────

# Replace with your actual ngrok backend URL (see docs/NGROK_SETUP.md)
NEXT_PUBLIC_API_URL=https://YOUR-NGROK-URL.ngrok-free.app

# Environment label: "demo" shows the yellow demo banner in the UI
NEXT_PUBLIC_APP_ENV=demo
