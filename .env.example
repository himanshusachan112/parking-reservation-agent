# ============================================
# Parking Space Reservation Chatbot - Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# === Google Gemini Configuration (FREE - RECOMMENDED) ===
# Get your free API key at: https://aistudio.google.com/apikey
# When set, this takes priority over Groq and DIAL
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# === Groq Configuration (FREE - Alternative to Gemini) ===
# Get your free key at: https://console.groq.com
# Used only if GOOGLE_API_KEY is not set
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# === EPAM DIAL (Azure OpenAI Proxy) ===
# Used only if neither Gemini nor Groq keys are set
# Requires EPAM network access
AZURE_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_API_KEY=your-dial-api-key-here
API_VERSION=2024-02-01
LLM_MODEL=gpt-4o

# === Pinecone Vector Database ===
# Get your API key from: https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=parking
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws

# === Local Embedding Model ===
# Free sentence-transformers model, no API needed
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Database ===
# SQLite for local development (auto-created)
SQL_DATABASE_URL=sqlite:///./data/parking_dynamic.db
# PostgreSQL for production (optional, leave empty for SQLite)
DATABASE_URL=

# === CORS (comma-separated, no spaces) ===
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Guardrails ===
GUARDRAILS_ENABLED=true
PII_CONFIDENCE_THRESHOLD=0.7

# === Evaluation Settings ===
EVAL_TOP_K=5

# === Email/SMTP Configuration ===
# For Gmail: Generate App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=admin@parksmart.com

# === Frontend Base URL (for payment links in emails) ===
APP_BASE_URL=http://localhost:3000
