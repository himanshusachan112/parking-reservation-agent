# ============================================
# Parking Space Reservation Chatbot - Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# EPAM DIAL (Azure OpenAI Proxy) Configuration
AZURE_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_API_KEY=your_dial_api_key_here
API_VERSION=2024-02-01

# Model Configuration
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=parking_info

# SQL Database
SQL_DATABASE_URL=sqlite:///./data/parking_dynamic.db

# Guardrails Configuration
GUARDRAILS_ENABLED=true
PII_CONFIDENCE_THRESHOLD=0.7

# Evaluation Settings
EVAL_TOP_K=5

# Email / SMTP Configuration (Stage 2 - User Notifications)
# For Gmail: use an App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=admin@example.com
