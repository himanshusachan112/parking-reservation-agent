# ============================================
# Parking Space Reservation Chatbot - Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# EPAM DIAL (Azure OpenAI Proxy) Configuration
AZURE_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_API_KEY=your-dial-api-key-here
API_VERSION=2024-02-01
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Pinecone Configuration
# Get your API key from https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=parking-info
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=aws

# SQL Database
SQL_DATABASE_URL=sqlite:///./data/parking_dynamic.db

# Guardrails Configuration
GUARDRAILS_ENABLED=true
PII_CONFIDENCE_THRESHOLD=0.7

# Evaluation Settings
EVAL_TOP_K=5

# Email / SMTP Configuration
# For Gmail: use an App Password, not your real password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=admin@parksmart.com

# Email / SMTP Configuration (Stage 2 - User Notifications)
# For Gmail: use an App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=admin@example.com
